# ============================================================
# M-Pesa Daraja API Configuration — lucysees
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.
# ============================================================

# Safaricom Daraja API credentials
# Get these from https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Your M-Pesa short code (Paybill or Till Number)
MPESA_SHORTCODE=your_shortcode_here

# STK Push passkey (provided by Safaricom)
MPESA_PASSKEY=your_passkey_here

# Environment: "sandbox" for testing, "production" for live
MPESA_ENVIRONMENT=sandbox

# The public base URL of your deployed Next.js app.
# M-Pesa will POST callbacks to this URL — it must be publicly accessible.
# For local dev use a tunnel like ngrok: https://your-tunnel.ngrok-free.app
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Optional: A secret token to verify incoming M-Pesa callbacks
# Generate with: openssl rand -hex 32
MPESA_CALLBACK_SECRET=your_random_secret_here
